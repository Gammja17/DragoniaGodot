 "SCENES": {
  "evening_guardian": { "title": "돌아온 저녁", "lines": [
   { "who": "나", "text": "(마을에 들어서니 해가 지고 있었다. 모닥불 옆에 스승이 먼저 와 앉아 있다.)", "do": [{ "bgm": "none" }, { "tone": "warm" }, { "cam": "Kairon", "time": 1.6, "zoom": 1.08 }] },
   { "who": "Kairon", "text": "…왔냐.", "do": [{ "cam": "auto", "zoom": 1.18 }] },
   { "who": "Kairon", "text": "(스승은 한참 동안 대답 없이 하늘만 올려다보았다.)", "do": [{ "face": "Kairon", "to": "up" }, { "wait": 1.8 }] },
   { "who": "Kairon", "text": "뒤에서 보는 하늘도 넓더라고. …형이 그 말을 할 줄은 몰랐다.", "zoom": 1.3 },
   { "who": "Kairon", "text": "네가 전에 그랬지. 뒤에서 보는 하늘도 넓던데요, 하고. 형도 똑같은 말을 하더라.", "chose": "k2:sky" },
   { "who": "Kairon", "text": "…그 양반, 끝까지 말은 번지르르하게 하는군.", "do": [{ "emote": "Kairon", "icon": "…" }] },
   { "who": "Kairon", "text": "됐다. 들어가서 자라. 나는 여기 좀 더 앉아 있다 가마. …오늘은 잔소리 안 한다." }
  ] },
  "evening_redeem": { "title": "돌아온 저녁", "lines": [
   { "who": "나", "text": "(마을 어귀 바위 옆에 이그나르를 내려놓고 들어왔다. 해가 지고 있었다. 모닥불 옆에 스승이 먼저 와 앉아 있다.)", "do": [{ "bgm": "none" }, { "tone": "warm" }, { "cam": "Kairon", "time": 1.6, "zoom": 1.08 }] },
   { "who": "Kairon", "text": "…왔냐. 형은 어귀에 있고?", "do": [{ "cam": "auto", "zoom": 1.18 }] },
   { "who": "나", "text": "(바위에 기대 쉬고 있다고 말했다.)", "zoom": 1.3 },
   { "who": "Kairon", "text": "같이 날아 내려오면서 한마디도 못 했다. 예순 해를 기다렸는데, 막상 옆에 있으니까 할 말이 하나도 생각이 안 나더라." },
   { "who": "Kairon", "text": "(스승은 어귀 쪽을 한참 바라보다가, 등을 돌렸다.)", "do": [{ "face": "Kairon", "to": "left" }, { "wait": 1.4 }] },
   { "who": "Kairon", "text": "…날 밝으면 가마. 너는 들어가 자라. 수고했다." }
  ] },
  "epi_dojo": { "title": "", "lines": [
   { "who": "Nara", "text": "스승님! …아니, 카이론 아저씨! 오늘은 나랑 대련해 주는 거죠? 약속했잖아요!", "do": [{ "bgm": "village" }, { "move": "Nara", "to": [150, -20] }] },
   { "who": "Kairon", "text": "약속한 적 없다. 허수아비나 쳐라." },
   { "who": "Nara", "text": "아 짜증 나. 맨날 허수아비래.", "do": [{ "move": "Nara", "to": [60, 90] }, { "fx": "PUFF", "at": "Nara" }, { "sfx": "hit" }] },
   { "who": "나", "text": "(나라는 허수아비 앞에서 하나, 하고 숨을 고른 뒤에 들어간다. 한 박자 늦게.)", "chose": "n1:tip" },
   { "who": "나", "text": "(나라는 여전히 몸이 먼저 나간다. 엄마를 닮았다는 그 버릇대로, 누구보다 빠르게.)", "chose": "n1:mom" },
   { "who": "Kairon", "text": "(허수아비를 두들기는 나라를 한참 보다가, 스승이 혼잣말처럼 중얼거렸다.) …꼬리 쓰는 게 늘었군. 내 제자답게.", "do": [{ "wait": 1.0 }] },
   { "who": "Nara", "text": "…방금 뭐라고 했어요? 제자라고 했죠? 했죠?!", "do": [{ "emote": "Nara", "icon": "!" }, { "move": "Nara", "to": "near:Kairon" }] },
   { "who": "Kairon", "text": "안 했다. 헛것 들었다. …백 번 더 쳐라." },
   { "who": "Nara", "text": "(나라는 투덜대며 허수아비 앞으로 돌아갔다. 꼬리가 아까보다 두 배는 세게 휘둘러졌다.)", "do": [{ "move": "Nara", "to": [60, 90] }, { "emote": "Nara", "icon": "♪" }] }
  ] },
  "epi_falls": { "title": "", "lines": [
   { "who": "나", "text": "(폭포 아래에는 이제 달이 밝지 않은 밤에도 불이 피었다.)", "do": [{ "bgm": "lake" }, { "cam": "look:PROP:CAMPFIRE", "time": 1.6 }] },
   { "who": "Yuan", "text": "…또 왔군. 오늘은 약초 핑계도 안 대나.", "do": [{ "cam": "auto" }] },
   { "who": "Mira", "text": "약초라면 이제 구름마루에 올라가서 캐도 되잖아. 어디서 나는지 네가 다 알려 줬으면서." },
   { "who": "Yuan", "text": "……", "do": [{ "emote": "Yuan", "icon": "…" }] },
   { "who": "Yuan", "text": "경계는 이제 하루 한 번만 돈다. …남는 시간엔 여기 있지." },
   { "who": "Riun", "text": "(불가 건너편에서 리운이 잔을 들어 보였다.) 아랫마을 촌장, 오늘은 누가 먼저 취하는지 봅시다." },
   { "who": "Elder", "text": "허허… 이 나이에 내기라니. 무릎이 시려서 오래는 못 앉아 있단다… 한 잔만 하자꾸나." }
  ] },
  "epi_tower": { "title": "", "lines": [
   { "who": "Tiamat", "text": "오늘 밤도 조용해.", "do": [{ "bgm": "none" }, { "cam": "look:PROP:TOWER", "time": 1.2 }, { "cam": "auto" }] },
   { "who": "Tiamat", "text": "…나팔을 안 부는 밤이 이렇게 긴 줄 몰랐어." },
   { "who": "Poco", "text": "누나, 그럼 이제 자도 돼? 있잖아, 나 오늘은 누나 옆 말고 내 굴에서 잘래. …그래도 되지? 그치?", "do": [{ "move": "Poco", "to": "near:Tiamat" }] },
   { "who": "Tiamat", "text": "…그래. 들어가 자. 오늘은 내가 볼게.", "do": [{ "emote": "Tiamat", "icon": "♥" }] },
   { "who": "Tiamat", "text": "(포코가 뛰어가자, 티아맷은 여느 밤처럼 망루 위에서 이름을 하나씩 불렀다. 아홉 번째 이름을 부를 때, 목소리가 조금 덜 떨렸다.)", "do": [{ "exit": "Poco" }, { "wait": 0.8 }, { "tone": "warm" }] }
  ] },
  "epi_lake": { "title": "", "lines": [
   { "who": "나", "text": "(호숫가 빈 굴 앞 바위에, 오늘도 고기 한 점이 놓여 있다.)", "do": [{ "bgm": "lake" }, { "cam": "Ignar", "time": 1.4 }] },
   { "who": "Poco", "text": "(바위 뒤에서 빼꼼 내다보던 포코가, 눈이 마주치자 후다닥 달아났다.)", "do": [{ "move": "Poco", "to": "near:Ignar" }, { "emote": "Poco", "icon": "!" }, { "exit": "Poco" }] },
   { "who": "Ignar", "text": "……", "do": [{ "cam": "auto" }] },
   { "who": "Ignar", "text": "고맙다는 말은… 들리게 해 줄 걸 그랬나." },
   { "who": "Kairon", "text": "(언제 왔는지 스승이 바위 반대편에 앉아 있었다.) 내일은 형이 먼저 말을 걸어 보시오. 저 녀석, 말 한마디 걸어 주면 사흘은 떠들 거요." },
   { "who": "Ignar", "text": "…삼백 년을 살아도 모르는 게 있구나. 꼬마한테 말 거는 법 같은 것." }
  ] },
  "epi_dark_falls": { "title": "", "lines": [
   { "who": "Haru", "text": "나라, 또 여기 있어? 아랫마을은 오늘도 조용하던데.", "do": [{ "bgm": "lake" }, { "tone": "grief" }] },
   { "who": "Nara", "text": "알아. 조용해서 보는 거야." },
   { "who": "Nara", "text": "(나라는 폭포 아래, 재가 내리는 쪽을 오래 내려다보았다.)", "do": [{ "wait": 1.2 }] },
   { "who": "Nara", "text": "…됐고. 수련이나 하자. 다음에 만나면, 그땐 내가 이길 거거든?", "do": [{ "emote": "Nara", "icon": "💢" }] }
  ] }
 },
